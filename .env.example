# Database: Local dev uses embedded PostgreSQL (PGlite) on disk.
# On Vercel / production, set to your hosted Neon or Supabase PostgreSQL URL:
# DATABASE_URL="postgresql://user:password@ep-example.neon.tech/papervault?sslmode=require"
DATABASE_URL="pglite://./data/pgdata"

# Object Storage: "local" for development, "s3" for Cloudflare R2 / AWS S3 (required on Vercel)
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./storage"

# S3 / Cloudflare R2 Configuration (required when STORAGE_PROVIDER="s3")
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Auth & Session Secret (REQUIRED in production: minimum 32 random characters)
SESSION_SECRET="dev-change-this-to-a-64-char-random-secret-before-production-use"

# Admin Credentials (used by db:seed and first-boot cloud Postgres bootstrap)
ADMIN_SEED_EMAIL="admin@college.edu"
ADMIN_SEED_PASSWORD="ChangeMe@Admin123"
ADMIN_SEED_NAME="Exam Cell Admin"
